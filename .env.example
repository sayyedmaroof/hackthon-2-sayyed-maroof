# ── Database (required) ──────────────────────────────────────────────
# PostgreSQL connection string used by the app and drizzle-kit.
DATABASE_URL=postgresql://user:password@localhost:5432/scentbuild

# ── Stripe (sandbox/test mode) ───────────────────────────────────────
# Server-only secret key for creating Checkout Sessions.
# Find it in the Stripe dashboard (test mode): developers > API keys.
STRIPE_SECRET_KEY=

# Webhook signing secret for /api/webhooks/stripe.
# Deployed (sandbox destination in Vercel): set in Vercel env vars.
# Local `stripe listen` prints its own whsec_... — use that locally and do NOT
# overwrite the deployed value.
STRIPE_WEBHOOK_SECRET=

# Public origin used to build trusted redirect URLs (success/cancel).
# Local: http://localhost:3000 · Production: https://hackthon-2-sayyed-maroof.vercel.app
NEXT_PUBLIC_APP_URL=

# ── AI providers (required keys) ─────────────────────────────────────
# Gemini is the primary provider; Groq is the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# ── AI options (all optional — sensible defaults are used) ───────────
# Primary provider: "gemini" (default) or "groq".
# AI_PROVIDER=gemini
# AI_GEMINI_MODEL=gemini-3.5-flash
# AI_GROQ_MODEL=openai/gpt-oss-120b
# AI_REQUEST_TIMEOUT_MS=12000
# AI_MAX_OUTPUT_TOKENS=4096

# ── Testing (optional) ───────────────────────────────────────────────
# Base URL the Playwright e2e suite runs against.
# E2E_BASE_URL=http://localhost:3000
